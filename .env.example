# Copy to .env and fill in. .env is gitignored; this template is not.
# Nothing in the default pipeline needs any of these — detection runs from
# local YOLO weights and the benchmark is fully offline. They are only for the
# optional paths below.

# Legacy hosted detection (src/schematic2netlist/detect.py). Unused while
# detect.backend is "ultralytics", which is the shipped default.
ROBOFLOW_API_KEY = your_api_key_here

# VLM external anchor — scripts/vlm_baseline.py (Anthropic) and
# scripts/vlm_openai.py (OpenAI). Each runner needs only its own provider's
# key; run one, both, or neither.
ANTHROPIC_API_KEY = your_api_key_here
OPENAI_API_KEY = your_api_key_here
