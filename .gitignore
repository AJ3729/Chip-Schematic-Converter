# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
venv/
.venv/

# Environment variables
.env
.env.*
!.env.example

# Data (raw images, cleaned images, annotations, GT netlists, per-image
# detection caches) — provenance documented in data/README.md.
# Exceptions: frozen split manifests and the data README are versioned —
# they are part of the benchmark contribution (C1).
data/*
!data/splits/
!data/README.md

# Experiment outputs (runs, logs, per-run config snapshots, legacy artifacts)
experiments/

# Model weights
*.pt
*.pth
*.onnx
weights/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local archives and migration backups (large, regenerable / transferred by hand)
*.zip
*.tgz
*.tar.gz
backups/

# Per-image benchmark artifacts (bulky, regenerable). Summaries, per-image
# CSVs and run metadata ARE committed — they are the reported numbers.
results/**/ledgers/
results/**/netlists/
demo/runs/

# VLM batch upload payloads: base64-encoded images, ~200 MB across both
# variants at 3 repeats, fully regenerable from the committed prompts + code.
# They are staged in a temp dir and deleted after upload; this is the guard
# against a stray --jsonl-dir or --keep-jsonl putting them in the history.
# Nothing else in the repo uses .jsonl; `git add -f` if that ever changes.
*.jsonl
